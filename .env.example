# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. Leave empty during local experiments.
AI_OFFICE_ALLOWED_CHAT_IDS=

# Workspace and routing
AI_OFFICE_WORKSPACE_ROOT=/home/nekach/projects
AI_OFFICE_PROMPT_DIR=/home/nekach/projects/ai-office-kernel/prompts
AI_OFFICE_MEMORY_MESSAGES=30
AI_OFFICE_QA_ENABLED=false

# Local Ollama secretary/router model
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OFFICE_ROUTER_MODEL=qwen3:8b
# gemini or local
AI_OFFICE_DEVELOPER_BACKEND=gemini
AI_OFFICE_QA_BACKEND=gemini
AI_OFFICE_LOCAL_CODER_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
AI_OFFICE_LOCAL_QA_MODEL=qwen3:8b

# Cloud CLI adapter. The command must already be installed and authenticated.
AI_OFFICE_GEMINI_CMD=gemini
AI_OFFICE_GEMINI_MODEL=auto
AI_OFFICE_GEMINI_OUTPUT_FORMAT=json
# default, auto_edit, yolo, plan
AI_OFFICE_GEMINI_APPROVAL_MODE=auto_edit
AI_OFFICE_GEMINI_SKIP_TRUST=true
AI_OFFICE_GEMINI_SANDBOX=false
AI_OFFICE_GEMINI_ALL_FILES=false
AI_OFFICE_GEMINI_INCLUDE_DIRECTORIES=
# Deprecated in Gemini CLI, but still accepted by current builds. Prefer policy files for serious use.
AI_OFFICE_GEMINI_ALLOWED_TOOLS=read_file,write_file,run_shell_command,export_file
# latest or concrete session id if you want process-per-message continuation.
AI_OFFICE_GEMINI_RESUME=
AI_OFFICE_CLI_TIMEOUT_SECONDS=1200
AI_OFFICE_PROGRESS_FIRST_SECONDS=45
AI_OFFICE_PROGRESS_INTERVAL_SECONDS=60
AI_OFFICE_AUTO_CONFIRM_CLI=false
AI_OFFICE_SHOW_USAGE=true
